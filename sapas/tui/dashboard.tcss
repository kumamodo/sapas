/* ==========================================================================
   Global Screen & Application Root Settings
   ========================================================================== */

Screen {
    background: $background;
    color: $foreground;
}

Screen, Widget {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $foreground 40%;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
}

#app-root {
    height: 100%;
    width: 100%;
    layout: vertical;
}

#app-root.sf-disabled {
    border: heavy $error;
    border-subtitle-align: center;
}

#app-root.sf-disabled.blink {
    border: heavy $panel;
}

#app-root.debug-mode,
#app-root.sf-disabled.debug-mode,
#app-root.sf-disabled.blink.debug-mode {
    border: heavy $warning;
    border-subtitle-align: center;
    border-subtitle-style: bold;
}

/* ==========================================================================
   Standard TUI Component Overrides (Header & Footer)
   ========================================================================== */

Header {
    text-style: bold;
    background: $primary;
    color: $foreground;
}

Footer {
    background: $panel;
}

Footer > .footer--key {
    color: $accent;
    background: $primary;
    text-style: bold;
}

Footer > .footer--description {
    color: $foreground;
}

/* ==========================================================================
   Top Dashboard Section (Information, Status, and Controls)
   ========================================================================== */

#top-row {
    height: 6;
    layout: grid;
    grid-size: 4;
    grid-columns: 55 24 1fr 2fr; 
    grid-gutter: 1;
    /* Reduce bottom padding to 0 to minimize visual gap with the main body */
    padding: 1 1 0 1; 
}

.top-box {
    height: 100%;
    background: $panel;
    border: solid $secondary;
    padding: 0 1;
    border-title-align: left;
    border-title-style: bold;
    align: center middle; 
}

.box-value {
    height: 100%;
    content-align: center middle;
    color: $foreground;
    text-style: bold;
}

#info-value {
    content-align: left middle;
    padding-left: 2;
}

/* --- Status Indicator Styles (Error Code Box) --- */
#error-code {
    width: 100%;
    height: 1;
    content-align: center middle;
    color: $foreground;
    text-style: bold;
}

#error-code.fail {
    background: $error;
    color: #ffffff;
    text-style: bold;
}

#error-code.running {
    background: $warning;
    color: #111111;
    text-style: bold;
}

#error-code.check {
    background: $warning;
    color: #111111;
    text-style: bold;
}

#error-code.pass {
    background: $success;
    color: #111111;
    text-style: bold;
}

/* --- Diagnostic Timer Styles --- */
#elapsed-box {
    align: center middle;
}

#elapsed-time {
    color: $warning;
    text-align: center;
    width: auto;
    height: auto;
}

/* --- Serial Number Input & Action Trigger Controls --- */
#serial-box {
    layout: horizontal;
    align: center middle;
}

#serial-input {
    width: 1fr;
    height: 3;
    margin: 0;
    padding: 0 1;
    background: $background;
    color: $foreground;
    border: solid $primary;
    text-style: bold;
}

#serial-input:focus {
    border: solid $accent;
}

#serial-input:disabled {
    color: $foreground;
    border: solid $secondary;
    opacity: 0.5;
}

#start-button {
    width: 12;
    height: 3;
    margin: 0;
    margin-left: 2;
    content-align: center middle;
    border: solid $primary;
    background: $panel;
    color: $foreground;
    text-style: bold;
}

#start-button:focus,
#start-button:hover {
    border: solid $accent;
}

#start-button:disabled {
    border: solid $secondary;
    color: $foreground;
    background: $panel;
    opacity: 0.5;
}

/* ==========================================================================
   Main Body Section (Test Items List and Execution Live Log)
   ========================================================================== */

#main-body {
    height: 1fr;
    layout: grid;
    grid-size: 2;
    grid-columns: 55 1fr;
    grid-gutter: 1;
    padding: 1;
}

#items-panel,
#log-panel {
    height: 100%;
    background: $panel;
    border: solid $secondary;
}

/* --- Left Column: Test Steps Management --- */
#items-panel {
    layout: vertical;
    padding: 0;
}

#items-table {
    height: 1fr;
    background: $surface;
    color: $foreground;
    border: none;
}

#items-table > .datatable--even-row {
    background: $surface;
}

#items-table > .datatable--odd-row {
    background: $panel;
}

#items-table > .datatable--header {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

#items-table > .datatable--cursor {
    background: $primary;
    color: $accent;
    text-style: bold;
}

#step-detail-bar {
    height: 4;
    background: $panel;
    border-top: solid $secondary;
    padding: 0 1;
    color: $foreground;
    content-align: left middle;
}

/* --- Right Column: Live Diagnostic Logs & Banners --- */
#log-panel {
    layout: vertical;
    padding: 0;
}

#log-title {
    height: 1;
    background: $secondary;
    color: $foreground;
    text-style: bold;
    content-align: center middle;
}

/* --- Execution Result Overlay Banner --- */
#result-banner {
    height: 0;
    background: $surface;
    content-align: center middle;
    text-style: bold;
    border: none;
    margin: 0 1;
}

#result-banner.active {
    height: 5;
    margin: 1;
}

#result-banner.pass {
    border: heavy $success;
    color: $success;
}

#result-banner.check {
    border: heavy $warning;
    color: $warning;
}

#result-banner.fail {
    border: heavy $error;
    color: $error;
}

#live-log {
    height: 1fr;
    background: $surface;
    color: $foreground;
    border: none;
}

/* ==========================================================================
   Responsive Layout Rules (Fallback for Narrow Displays)
   ========================================================================== */

Screen.narrow #top-row {
    grid-size: 1 4;
    grid-columns: 1fr;
    height: 24;
}

Screen.narrow #main-body {
    grid-size: 1 2;
    grid-columns: 1fr;
    grid-rows: 1fr 2fr;
}

/* ==========================================================================
   Operator Confirmation Dialogs
   ========================================================================== */

QuitConfirmScreen {
    align: center middle;
    background: #000000 65%;
}

#quit-dialog {
    width: 64;
    height: 11;
    grid-size: 5;
    grid-columns: 1fr 16 8 16 1fr;
    grid-rows: 2 1fr 3;
    grid-gutter: 1;
    padding: 1 2;
    background: $panel;
    border: heavy $accent;
}

#quit-title {
    column-span: 5;
    content-align: center middle;
    text-style: bold;
    color: $foreground;
}

#quit-message {
    column-span: 5;
    content-align: center middle;
    color: $foreground;
}

#quit-yes,
#quit-no {
    height: 3;
    width: 100%;
}

.quit-spacer {
    height: 3;
}

/* ==========================================================================
   Remote Restart Required Modal Dialog
   ========================================================================== */

RemoteRestartScreen {
    align: center middle;
    background: #000000 75%;
}

#restart-dialog {
    width: 78;
    height: auto;
    background: $panel;
    border: heavy $accent;
    padding: 1 3;
    layout: vertical;
}

#restart-dialog-title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 1;
    margin-bottom: 1;
}

#restart-dialog-bullets {
    content-align: left middle;
    color: $foreground;
    text-align: left;
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
}

#restart-dialog-prompt {
    content-align: center middle;
    color: #4FC3F7;
    text-align: center;
    text-style: bold;
    height: auto;
    margin-top: 1;
    margin-bottom: 2;
}

#restart-dialog-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-bottom: 1;
}

#restart-confirm-btn {
    width: 36;
    height: 3;
    text-style: bold;
}

#restart-confirm-btn:focus {
    border: solid $accent;
}


/* ==========================================================================
   Device Manager Overlay Screen & Dialog
   ========================================================================== */

DeviceManagerScreen {
    align: center middle;
    background: #000000 75%;
}

#dev-manager-dialog {
    width: 90;
    height: 24;
    background: $panel;
    border: heavy $accent;
    padding: 1 2;
    layout: vertical;
}

#dev-manager-title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 1;
    margin-bottom: 1;
}

#dev-manager-table {
    height: 12;
    background: $surface;
    color: $foreground;
    border: none;
}

#dev-manager-table > .datatable--header {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

#dev-manager-status {
    height: 1;
    content-align: center middle;
    color: $warning;
    margin: 0;
    text-style: italic;
}

#dev-manager-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-top: 2;
}

#dev-btn-refresh,
#dev-btn-close {
    width: 20;
    height: 3;
    margin: 0 8;
    text-style: bold;
}

#dev-btn-refresh:focus,
#dev-btn-close:focus {
    border: solid $accent;
}

/* ==========================================================================
   Network Manager Overlay Screen & Dialog
   ========================================================================== */

NetworkManagerScreen {
    align: center middle;
    background: #000000 75%;
}

#net-manager-dialog {
    width: 90;
    height: 24;
    background: $panel;
    border: heavy $accent;
    padding: 1 2;
    layout: vertical;
}

#net-manager-title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 1;
    margin-bottom: 1;
}

#net-manager-table {
    height: 12;
    background: $surface;
    color: $foreground;
    border: none;
}

#net-manager-table > .datatable--header {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

#net-manager-status {
    height: 1;
    content-align: center middle;
    color: $warning;
    margin: 0;
    text-style: italic;
}

#net-manager-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-top: 2;
}

#net-btn-refresh,
#net-btn-close {
    width: 20;
    height: 3;
    margin: 0 8;
    text-style: bold;
}

#net-btn-refresh:focus,
#net-btn-close:focus {
    border: solid $accent;
}

StationMonitorScreen {
    align: center middle;
    background: #000000 75%;
}

#station-monitor-dialog {
    width: 90;
    height: 24;
    background: $panel;
    border: heavy $accent;
    padding: 1 2;
    layout: vertical;
}

#station-monitor-title {
    content-align: center middle;
    text-style: bold;
    color: $accent;
    height: 1;
    margin-bottom: 1;
}

#station-monitor-table {
    height: 12;
    background: $surface;
    color: $foreground;
    border: none;
    scrollbar-size-horizontal: 0;
}

#station-monitor-table > .datatable--header {
    background: $secondary;
    color: $foreground;
    text-style: bold;
}

#station-monitor-status {
    height: 1;
    content-align: center middle;
    color: $warning;
    margin: 0;
    text-style: italic;
}

#station-monitor-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-top: 2;
}

#monitor-btn-close {
    width: 24;
    height: 3;
    text-style: bold;
}

#monitor-btn-close:focus {
    border: solid $accent;
}

/* Micro Editor Modal Styles */
MicroEditorScreen {
    align: center middle;
    background: #000000 80%;
}

#editor-dialog {
    width: 98%;
    height: 96%;
    background: $panel;
    border: heavy $accent;
    padding: 1 2;
    layout: vertical;
}

#editor-header {
    height: 1;
    margin-bottom: 1;
}

#editor-title {
    text-style: bold;
    color: $accent;
    width: 1fr;
}

#editor-step-label {
    text-style: italic;
    color: $foreground;
    text-align: right;
    width: auto;
}

#editor-tab-bar {
    height: 3;
    margin-bottom: 1;
    layout: horizontal;
    align: left middle;
}

.editor-tab-btn {
    min-width: 26;
    width: auto;
    height: 3;
    margin-right: 1;
    background: #21262d;
    color: #8b949e;
    border: none !important;
    padding: 0 1;
}

.editor-tab-btn:hover {
    background: #30363d;
    color: #f0f6fc;
    border: none !important;
}

.editor-tab-btn.active {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
    border: none !important;
}

#editor-meta-bar {
    height: 1;
    margin-bottom: 1;
}

#editor-file-path {
    width: 1fr;
    color: $foreground;
    text-style: dim;
}

#editor-file-status {
    width: auto;
    text-align: right;
    text-style: bold;
}

#editor-text-area {
    height: 1fr;
    background: #0d1117;
    border: solid $secondary;
}

#editor-text-area:focus {
    border: solid $accent;
}

#editor-footer {
    height: 1;
    margin-top: 1;
}

#editor-hotkey-guide {
    width: 1fr;
    color: #ffffff;
    text-style: bold;
}

#editor-feedback-status {
    width: auto;
    text-align: right;
    text-style: bold;
}

/* Rollback Confirm Dialog Styles */
RollbackConfirmScreen {
    align: center middle;
    background: #000000 85%;
}

#rollback-dialog-container {
    width: 86;
    height: auto;
    max-height: 24;
    background: $panel;
    border: heavy $warning;
    padding: 1 4;
    layout: vertical;
}

#rollback-dialog-title {
    content-align: center middle;
    text-style: bold;
    color: $warning;
    height: 1;
    margin-bottom: 1;
}

#rollback-dialog-message {
    color: $foreground;
    margin-bottom: 1;
    content-align: center middle;
    text-align: center;
}

#rollback-dialog-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-top: 1;
    margin-bottom: 1;
}

#btn-keep-changes,
#btn-revert-changes {
    width: 24;
    height: 3;
    margin: 0 4;
    text-style: bold;
}

#btn-keep-changes:focus,
#btn-revert-changes:focus {
    border: solid $accent;
}

#rollback-dialog-hint {
    content-align: center middle;
    text-style: italic dim;
    color: $foreground;
    height: 1;
    margin-top: 1;
}

/* Unsaved Changes Confirmation Dialog */
UnsavedChangesScreen {
    align: center middle;
    background: #000000 85%;
}

#unsaved-dialog-container {
    width: 86;
    height: auto;
    max-height: 24;
    background: $panel;
    border: heavy $warning;
    padding: 1 4;
    layout: vertical;
}

#unsaved-dialog-title {
    content-align: center middle;
    text-style: bold;
    color: $warning;
    height: 1;
    margin-bottom: 1;
}

#unsaved-dialog-message {
    color: $foreground;
    margin-bottom: 1;
    content-align: center middle;
    text-align: center;
}

#unsaved-dialog-actions {
    layout: horizontal;
    height: 3;
    align: center middle;
    margin-top: 1;
    margin-bottom: 1;
}

#btn-unsaved-save,
#btn-unsaved-discard,
#btn-unsaved-cancel {
    width: 22;
    height: 3;
    margin: 0 2;
    text-style: bold;
}

#btn-unsaved-save:focus,
#btn-unsaved-discard:focus,
#btn-unsaved-cancel:focus {
    border: solid $accent;
}




